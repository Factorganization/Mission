<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PopupLevel" src="project://database/Assets/UI/Modals/PopupLevel/PopupLevel.uxml?fileID=9197481963319205126&amp;guid=d460acaebd2b5b74e8353f83ae5d1fea&amp;type=3#PopupLevel"/>
    <Style src="project://database/Assets/UI/Modals/MailPage/MailPage.uss?fileID=7433441132597879392&amp;guid=7cc61356d936a3e458d449908ea8bd48&amp;type=3#MailPage"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:VisualElement name="mailView" style="flex-grow: 1; background-color: rgb(255, 255, 255); background-size: 100% 100%; -unity-background-scale-mode: stretch-to-fill; flex-direction: column;">
            <ui:VisualElement name="search-bar" style="flex-grow: 0;">
                <ui:Button text=" " name="close-button" style="flex-wrap: nowrap; align-self: flex-end; background-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&amp;guid=4d04c27b1b2cf6548ba8f327870d1d87&amp;type=3#Remove@2x&quot;); justify-content: flex-start; align-items: stretch;"/>
                <ui:VisualElement name="title-mail" style="flex-grow: 1; border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; border-top-right-radius: 10px; width: auto;">
                    <ui:Label text="EMAIL " name="Label" style="background-size: 100% 100%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="mail-truecont" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="contact-list" style="flex-grow: 1; border-left-width: 1px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
                <ui:ScrollView name="mail-container" style="position: relative; height: auto; width: auto; left: auto; top: auto; border-top-width: 1px; border-left-width: 0; border-bottom-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); flex-grow: 3;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="PopupLevel" name="popup-level" style="position: absolute; height: 780px; width: 1021px; display: flex;"/>
    </ui:VisualElement>
</ui:UXML>
