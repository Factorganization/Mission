        "m_Id": "200d0678818b43668729c73adc332b80"
    },
    "m_Name": "GetLightingInformation (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3255.0,
            "y": -28.000038146972658,
